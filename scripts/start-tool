#!/usr/bin/env bash
# 通过 llm-monitor 代理启动 Claude Code / Codex CLI 工具
# 用法: llm-monitor <ClaudeCode|Codex|ChatGPT> [项目目录] [--port 9400]

set -euo pipefail

# ── 参数解析 ──
TOOL="${1:-}"
PORT=9400
PROJECT="$(pwd)"

[[ $# -gt 0 ]] && shift  # 跳过 TOOL（无参时不 shift，让后续校验报错）
while [[ $# -gt 0 ]]; do
  case "$1" in
    --port=*)
      PORT="${1#--port=}"
      shift
      ;;
    --port)
      PORT="${2:-9400}"
      [[ $# -ge 2 ]] && shift 2 || { echo "用法: llm-monitor <ClaudeCode|Codex|ChatGPT> [项目目录] [--port 9400]"; exit 1; }
      ;;
    -*)
      echo "未知选项: $1"
      exit 1
      ;;
    *)
      PROJECT="$1"
      shift
      ;;
  esac
done

# 标准化工具名（大小写不敏感；ChatGPT 视为 Codex）
case "$(printf '%s' "$TOOL" | tr '[:upper:]' '[:lower:]')" in
  claude|claudecode) TOOL="ClaudeCode" ;;
  codex|chatgpt)     TOOL="Codex" ;;
esac

if [[ "$TOOL" != "ClaudeCode" && "$TOOL" != "Codex" ]]; then
  echo "用法: llm-monitor <ClaudeCode|Codex|ChatGPT> [项目目录]"
  exit 1
fi

# 颜色
CYAN='\033[0;36m'
GRAY='\033[0;90m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${CYAN}=== llm-monitor 代理启动 ===${NC}"
echo -e "${GRAY}  工具: $TOOL${NC}"
echo -e "${GRAY}  项目: $PROJECT${NC}"
echo -e "${GRAY}  代理: http://localhost:$PORT${NC}"

# 预创建 pending 会话
SESSION_ID=""
if RESULT=$(curl -s -X POST "http://localhost:$PORT/proxy/sessions/start" \
  -H "Content-Type: application/json" \
  -d "{\"tool\":\"$TOOL\"}" 2>/dev/null); then
  SESSION_ID=$(echo "$RESULT" | grep -o '"id":[0-9]*' | head -1 | cut -d: -f2)
  if [[ -n "$SESSION_ID" ]]; then
    STATUS=$(echo "$RESULT" | grep -o '"status":"[^"]*"' | head -1 | cut -d'"' -f4)
    echo -e "${GREEN}  会话: #$SESSION_ID ($STATUS)${NC}"
  fi
else
  echo -e "${YELLOW}  会话预创建失败（代理可能未启动）${NC}"
fi

# 设置代理环境变量
export LLM_MONITOR_PORT="$PORT"
export LLM_MONITOR_TOOL="$TOOL"

case "$TOOL" in
  ClaudeCode)
    if [[ -n "$SESSION_ID" ]]; then
      export ANTHROPIC_BASE_URL="http://localhost:$PORT/s/$SESSION_ID/ClaudeCode"
    else
      export ANTHROPIC_BASE_URL="http://localhost:$PORT/ClaudeCode"
    fi
    export ANTHROPIC_AUTH_TOKEN="llm-monitor"
    echo -e "${GRAY}  启动 Claude Code...${NC}"
    cd "$PROJECT"
    claude
    ;;
  Codex)
    # Codex 不支持 OPENAI_BASE_URL 环境变量，只能通过 config.toml 配置
    CODEX_HOME="$HOME/.codex"
    CONFIG_PATH="$CODEX_HOME/config.toml"
    mkdir -p "$CODEX_HOME"
    if [[ -n "$SESSION_ID" ]]; then
      BASE_URL="http://localhost:$PORT/s/$SESSION_ID/Codex"
    else
      BASE_URL="http://localhost:$PORT/Codex"
    fi
    # 写入策略：不覆盖原有内容 — 代理 section 缺失时追加，base_url 每次都更新
    if [[ ! -f "$CONFIG_PATH" ]]; then
      # 配置文件不存在 → 写入完整代理配置
      cat > "$CONFIG_PATH" << TOML
model_provider = "LLM-Monitor"
preferred_auth_method = "apikey"
forced_login_method = "api"

[model_providers.LLM-Monitor]
name = "LLM-Monitor"
base_url = "$BASE_URL"
experimental_bearer_token = "llm-monitor"
wire_api = "responses"
TOML
      echo -e "${GRAY}  已写入 Codex 代理配置: $CONFIG_PATH${NC}"
    elif grep -q '^[[:space:]]*\[model_providers\.LLM-Monitor\]' "$CONFIG_PATH"; then
      # 代理 section 已存在 → 仅更新该 section 内的 base_url，不动其他内容
      # （表头探测容忍前导空白：TOML 允许缩进的 [section] 标题）
      TMP_FILE="$(mktemp)"
      if awk '/^[[:space:]]*\[model_providers\.LLM-Monitor\]/{f=1;next} f&&/^[[:space:]]*\[/{f=0} f&&/^[[:space:]]*base_url[[:space:]]*=/{found=1} END{exit !found}' "$CONFIG_PATH"; then
        # section 内已有 base_url → 原地替换（仅限本 section，避免误伤其他供应商的同名键）
        awk -v url="$BASE_URL" '
          /^[[:space:]]*\[model_providers\.LLM-Monitor\]/ { insec=1 }
          insec && /^[[:space:]]*\[/ && !/^[[:space:]]*\[model_providers\.LLM-Monitor\]/ { insec=0 }
          insec && /^[[:space:]]*base_url[[:space:]]*=/ { print "base_url = \"" url "\""; next }
          { print }
        ' "$CONFIG_PATH" > "$TMP_FILE"
      else
        # section 内缺少 base_url → 在 section 标题行后插入
        awk -v url="$BASE_URL" '
          { print }
          /^[[:space:]]*\[model_providers\.LLM-Monitor\]/ { print "base_url = \"" url "\"" }
        ' "$CONFIG_PATH" > "$TMP_FILE"
      fi
      mv "$TMP_FILE" "$CONFIG_PATH"
      echo -e "${GRAY}  Codex 配置已存在，仅更新 base_url（保留原有内容）${NC}"
    else
      # 无代理 section → 末尾追加；顶层 model_provider 缺失时插入文件顶部（TOML 顶层键须在 [section] 之前）
      if ! grep -Eq '^[[:space:]]*model_provider[[:space:]]*=' "$CONFIG_PATH"; then
        TMP_FILE="$(mktemp)"
        if head -c 3 "$CONFIG_PATH" | od -An -tx1 | grep -q 'ef bb bf'; then
          # 文件带 UTF-8 BOM → 新行插在 BOM 之后，保持 BOM 位于文件开头（TOML 仅允许 BOM 在首字节）
          printf '\xEF\xBB\xBFmodel_provider = "LLM-Monitor"\n\n' > "$TMP_FILE"
          tail -c +4 "$CONFIG_PATH" >> "$TMP_FILE"
        else
          printf 'model_provider = "LLM-Monitor"\n\n' | cat - "$CONFIG_PATH" > "$TMP_FILE"
        fi
        mv "$TMP_FILE" "$CONFIG_PATH"
      elif ! grep -Eq "^[[:space:]]*model_provider[[:space:]]*=[[:space:]]*[\"']LLM-Monitor[\"']" "$CONFIG_PATH"; then
        echo -e "${YELLOW}  ⚠ 配置顶层 model_provider 未指向 LLM-Monitor，如需走代理请手动切换${NC}"
      fi
      cat >> "$CONFIG_PATH" << TOML

[model_providers.LLM-Monitor]
name = "LLM-Monitor"
base_url = "$BASE_URL"
experimental_bearer_token = "llm-monitor"
wire_api = "responses"
TOML
      echo -e "${GRAY}  已在 Codex 配置末尾追加 LLM-Monitor 代理 section（保留原有内容）${NC}"
    fi
    echo -e "${GRAY}    base_url = $BASE_URL${NC}"
    echo -e "${GRAY}  启动 Codex...${NC}"
    cd "$PROJECT"
    codex
    ;;
esac
