{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["proxy/**/*.ts", "shared/**/*.ts", "webui/src/**/*.ts", "webui/src/**/*.tsx", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests/smoke-test.ts", "tests/verify.ts", "tests/start-and-test.ts"]
}
